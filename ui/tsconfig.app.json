{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // "node" as well as the browser: a script that runs under node rather
    // than in the page -- checking something, generating something -- is a
    // normal thing to want, and without this it cannot see `process` or
    // `Buffer`. @types/node is already a devDependency.
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* Off, and not by preference: the generated protobuf code spells its enums
       as TypeScript `enum`s, which this forbids. It is not ours to change. */
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
